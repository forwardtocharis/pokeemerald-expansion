	end

Route4_Text_Sign1:
	.string "Route4$"

Route4_Text_Sign2:
	.string "Route4$"

Route4_Text_BrockFamousLeader:
	.string "BROCK is famous throughout KANTO\n"
	.string "as a tough GYM LEADER!$"

Route4_Text_TrippedOverGeodude:
	.string "Ouch! I tripped over a rocky\n"
	.string "POKéMON, GEODUDE!$"

